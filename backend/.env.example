# Copy this file to .env and fill in real values as you get them.
# The app works with none of these set: it falls back to in-memory storage
# and mocks SMS sends (logged to the console) instead of failing.

# MongoDB connection string. Leave blank to use in-memory storage instead.
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=
MONGODB_DB=aquaalert

# Fast2SMS API key (https://www.fast2sms.com/dashboard). Leave blank to mock SMS sends.
FAST2SMS_API_KEY=

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
